---
import { existsSync, readdirSync } from 'node:fs';
import { join } from 'node:path';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import '../styles/projects.css';

const projects = (await getCollection('projects')).sort(
    (a, b) => a.data.order - b.data.order,
);

/* Read at build time so a stack entry with no matching SVG falls back to a text
   label — check-links fails CI on any src that does not resolve. Anchored to the
   project root because import.meta.url points at the bundled chunk in dist/. */
const stackDir = join(process.cwd(), 'public/images/stack');
const icons = new Set(
    existsSync(stackDir)
        ? readdirSync(stackDir)
              .filter((file) => file.endsWith('.svg'))
              .map((file) => file.replace(/\.svg$/, ''))
        : [],
);

const slug = (name: string) => name.replace(/\s+/g, '-');
---

<Base title="Projects | jstnc.dev" description="Projects by Justin Chiam.">
<main>
  <h1>projects</h1>

  <div class="projects-grid">
    {projects.map(({ data }) => {
      const Card = data.href ? 'a' : 'article';
      const link = data.href ? { href: data.href, target: '_blank', rel: 'noopener noreferrer' } : {};

      return (
        <Card class="project" {...link}>
          <img class="project-image" src={data.image} alt={`${data.name} screenshot`} loading="lazy" decoding="async" />
          <div class="project-body">
            <div>
              <div class="row">
                <h2>
                  {data.href ? data.name : (
                    <span class="closed" tabindex="0" aria-describedby={`${slug(data.name)}-note`}>
                      {data.name}<span class="tip" id={`${slug(data.name)}-note`} role="tooltip">{data.note}</span>
                    </span>
                  )}
                </h2>
                <span class="date">{data.date}</span>
              </div>
              <p class="desc">{data.description}</p>
            </div>
            <hr />
            <div class="project-stack">
              {data.stack.map((name) => (
                icons.has(name)
                  ? <img src={`/images/stack/${name}.svg`} alt={name} title={name} width="25" height="25" />
                  : <span class="stack-label">{name}</span>
              ))}
            </div>
          </div>
        </Card>
      );
    })}
  </div>

  <a class="back" href="/">back</a>
</main>
</Base>
